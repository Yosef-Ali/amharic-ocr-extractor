# Google Gemini AI — required for OCR, chat, and image generation
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Admin email(s) — comma-separated; users with these emails see the admin panel
VITE_ADMIN_EMAIL=admin@example.com

# Neon database connection string (serverless)
VITE_DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require

# Neon Auth URL — typically https://ep-xxxx.neonauth.c-4.us-east-1.aws.neon.tech/neondb/auth
VITE_NEON_AUTH_URL=https://your-project.neonauth.c-4.us-east-1.aws.neon.tech/neondb/auth

# Optional: server-side salt for hashing guest IPs in the OCR rate limiter.
# Any random string. Without it the hashes are still not raw addresses, but the
# IPv4 space is small enough to brute-force an unsalted digest — set this in
# production. Changing it resets everyone's guest allowance once.
# GUEST_IP_SALT=

# Optional: Anthropic-compatible proxy (e.g. MiniMax) for alternative AI models
# VITE_ANTHROPIC_BASE_URL=
# VITE_ANTHROPIC_API_KEY=
# VITE_ANTHROPIC_MODEL=
